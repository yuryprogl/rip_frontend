{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "frontend",
  "version": "0.1.0",
  "identifier": "com.lab6.prod",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "frontend",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],

    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
